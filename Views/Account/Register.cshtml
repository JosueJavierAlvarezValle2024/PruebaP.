@model RegisterViewModel
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Crear Cuenta";
}

@* ===== Título y subtítulo ===== *@
<div class="mb-4 text-center">
    <h1 class="h4 fw-bold" style="color:#1a2332;">Crear Cuenta</h1>
    <p class="mb-0" style="font-size:0.875rem; color:#6b7280;">Registra un nuevo usuario en el sistema</p>
</div>

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

@* ===== Formulario de registro ===== *@
<form method="post" asp-action="Register" asp-controller="Account">
    @Html.AntiForgeryToken()

    @* Nombre completo *@
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre completo</label>
        <input asp-for="Nombre"
               class="form-control"
               placeholder="Juan Pérez"
               autocomplete="name" />
        <span asp-validation-for="Nombre" class="text-danger" style="font-size:0.8rem;"></span>
    </div>

    @* Email *@
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Correo electrónico</label>
        <input asp-for="Email"
               class="form-control"
               placeholder="correo@empresa.com"
               autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem;"></span>
    </div>

    @* Contraseña *@
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Contraseña</label>
        <input asp-for="Password"
               class="form-control"
               placeholder="••••••••"
               autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem;"></span>
    </div>

    @* Confirmar contraseña *@
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
        <input asp-for="ConfirmPassword"
               class="form-control"
               placeholder="••••••••"
               autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.8rem;"></span>
    </div>

    @* Dropdown de Rol *@
    <div class="mb-4">
        <label asp-for="Rol" class="form-label">Rol</label>
        <select asp-for="Rol" class="form-select">
            <option value="">Selecciona un rol</option>
            <option value="Operario">Operario</option>
            <option value="Revisor">Revisor</option>
            <option value="Admin">Admin</option>
        </select>
        <span asp-validation-for="Rol" class="text-danger" style="font-size:0.8rem;"></span>
    </div>

    @* Botón principal *@
    <button type="submit" class="btn-auth">
        Crear usuario
    </button>

</form>

@* Divider y link de dashboard *@
<hr class="auth-divider" />
<p class="auth-link-text">
    <a asp-action="Index" asp-controller="Usuarios"><i class="bi bi-arrow-left me-1"></i>Volver al listado de usuarios</a>
</p>
