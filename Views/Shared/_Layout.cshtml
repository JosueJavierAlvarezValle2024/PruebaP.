<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NormaDoc</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @* ===== TOPBAR ===== *@
    <nav id="topbar" class="topbar fixed-top">
        <div class="topbar-left">
            <button id="sidebar-toggle" class="sidebar-toggle-btn" type="button" aria-label="Alternar menú">
                <i class="bi bi-list"></i>
            </button>
            <a href="/" class="topbar-brand">
                <i class="bi bi-file-earmark-text-fill brand-icon"></i>
                <span class="brand-name">NormaDoc</span>
            </a>
        </div>
        <div class="topbar-right">
            <button class="topbar-icon-btn" type="button" aria-label="Notificaciones">
                <i class="bi bi-bell"></i>
            </button>
            @{
                var _displayName = User.Identity?.Name ?? "Usuario";
                var _userRole    = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
            }
            <div class="topbar-user">
                <div class="user-avatar">@EstadoHelper.Iniciales(_displayName)</div>
                <div class="user-info">
                    <span class="user-name">@_displayName</span>
                    <span class="user-role">@_userRole</span>
                </div>
            </div>
        </div>
    </nav>

    @* ===== WRAPPER PRINCIPAL ===== *@
    <div id="wrapper">

        @* ===== SIDEBAR ===== *@
        <aside id="sidebar">
            <nav class="sidebar-nav">

                @* Sección NAVEGACIÓN *@
                <div class="sidebar-section">
                    <span class="sidebar-section-title">Navegación</span>
                    <ul class="sidebar-menu">
                        <li class="sidebar-item">
                            <a asp-action="Dashboard" asp-controller="Home" class="sidebar-link">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Revisor"))
                        {
                        <li class="sidebar-item">
                            <a asp-action="Index" asp-controller="Documentos" class="sidebar-link">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Documentos</span>
                            </a>
                        </li>
                        }
                    </ul>
                </div>

                @* Sección GESTIÓN *@
                @if (User.IsInRole("Admin") || User.IsInRole("Revisor"))
                {
                <div class="sidebar-section">
                    <span class="sidebar-section-title">Gestión</span>
                    <ul class="sidebar-menu">
                        @if (User.IsInRole("Admin"))
                        {
                        <li class="sidebar-item">
                            <a asp-action="Index" asp-controller="Usuarios" class="sidebar-link">
                                <i class="bi bi-people"></i>
                                <span>Usuarios</span>
                            </a>
                        </li>
                        }
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-bar-chart-line"></i>
                                <span>Reportes</span>
                            </a>
                        </li>
                    </ul>
                </div>
                }

                @* Sección SISTEMA *@
                <div class="sidebar-section">
                    <span class="sidebar-section-title">Sistema</span>
                    <ul class="sidebar-menu">
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-gear"></i>
                                <span>Configuración</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="sidebar-link btn-link-sidebar">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Cerrar sesión</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </nav>
        </aside>

        @* ===== ÁREA DE CONTENIDO ===== *@
        <div id="content-wrapper">
            <main id="main-content" role="main">
                @RenderBody()
            </main>

            @* ===== FOOTER ===== *@
            <footer id="main-footer">
                <span>NormaDoc &copy; 2025 &mdash; Sistema de Gestión Documental para Normativas de Calidad</span>
            </footer>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var toggle = document.getElementById('sidebar-toggle');
            var sidebar = document.getElementById('sidebar');
            var wrapper = document.getElementById('wrapper');
            if (toggle && sidebar) {
                toggle.addEventListener('click', function () {
                    sidebar.classList.toggle('collapsed');
                    wrapper.classList.toggle('sidebar-collapsed');
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
