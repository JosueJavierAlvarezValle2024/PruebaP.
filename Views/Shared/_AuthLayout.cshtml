<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NormaDoc</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --auth-gradient-start: #1e3a5f;
            --auth-gradient-end: #2d6a9f;
            --accent: #2d6cdf;
            --accent-hover: #1e55c0;
            --font-body: 'Inter', sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-body);
            font-size: 14px;
            background: linear-gradient(135deg, var(--auth-gradient-start) 0%, var(--auth-gradient-end) 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .auth-wrapper {
            width: 100%;
            max-width: 420px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
        }

        .auth-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .auth-brand-icon {
            font-size: 2.5rem;
            color: #ffffff;
            opacity: 0.95;
        }

        .auth-brand-name {
            font-size: 1.6rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.02em;
        }

        .auth-card {
            width: 100%;
            background: #ffffff;
            border-radius: 0.875rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
            padding: 2rem 2rem;
        }

        .auth-footer {
            font-size: 0.72rem;
            color: rgba(255, 255, 255, 0.55);
            text-align: center;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 500;
            color: #374151;
            margin-bottom: 0.35rem;
        }

        .form-control {
            font-size: 0.875rem;
            border: 1px solid #d1d5db;
            border-radius: 0.4rem;
            padding: 0.55rem 0.85rem;
            color: #1a2332;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(45, 108, 223, 0.15);
            outline: none;
        }

        .form-control::placeholder {
            color: #9ca3af;
        }

        .form-select {
            font-size: 0.875rem;
            border: 1px solid #d1d5db;
            border-radius: 0.4rem;
            padding: 0.55rem 0.85rem;
            color: #1a2332;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(45, 108, 223, 0.15);
            outline: none;
        }

        .btn-auth {
            width: 100%;
            background: var(--accent);
            color: #ffffff;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.65rem 1rem;
            border: none;
            border-radius: 0.4rem;
            cursor: pointer;
            transition: background 0.15s;
        }

        .btn-auth:hover {
            background: var(--accent-hover);
            color: #ffffff;
        }

        .auth-divider {
            border: none;
            border-top: 1px solid #e5e7eb;
            margin: 1.25rem 0;
        }

        .auth-link-text {
            font-size: 0.8rem;
            color: #6b7280;
            text-align: center;
        }

        .auth-link-text a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 500;
        }

        .auth-link-text a:hover {
            text-decoration: underline;
        }

        @*
            Responsive: en pantallas muy pequeñas reducir padding del card
        *@
    </style>
</head>
<body>

    <div class="auth-wrapper">

        @* Logo y nombre NormaDoc *@
        <a href="/" class="auth-brand">
            <i class="bi bi-file-earmark-text-fill auth-brand-icon"></i>
            <span class="auth-brand-name">NormaDoc</span>
        </a>

        @* Card de contenido *@
        <div class="auth-card">
            @RenderBody()
        </div>

        @* Footer *@
        <p class="auth-footer">NormaDoc &copy; 2025 &mdash; Sistema de Gestión Documental</p>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
