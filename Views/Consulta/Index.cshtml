@model IEnumerable<Documento>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Documentos Vigentes";
}

<div class="dashboard-header">
    <div>
        <h1 class="page-title">Documentos Vigentes</h1>
        <p class="page-subtitle mb-0">Consulta de documentos aprobados</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="q" value="@ViewBag.Q" class="form-control"
                   placeholder="Buscar por título..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-1"></i> Buscar
            </button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Q as string))
            {
                <a asp-action="Index" asp-controller="Consulta" class="btn btn-outline-secondary">
                    Limpiar
                </a>
            }
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Título</th>
                        <th>Versión</th>
                        <th>Fecha Aprobación</th>
                        <th>Extensión</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No hay documentos vigentes disponibles.
                            </td>
                        </tr>
                    }
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td class="ps-3">@doc.Titulo</td>
                            <td>v@doc.Version</td>
                            <td>@doc.FechaModificacion.ToString("dd/MM/yyyy")</td>
                            <td>@(doc.Extension?.ToUpper() ?? "—")</td>
                            <td>
                                @if (doc.RutaArchivo != null)
                                {
                                    <a asp-action="Download" asp-controller="Consulta" asp-route-id="@doc.Id"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-download me-1"></i> Descargar
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Sin archivo</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-end">
        <a href="@ViewBag.ModuloConsultaUrl" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener">
            Ver portal de consulta pública <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>
