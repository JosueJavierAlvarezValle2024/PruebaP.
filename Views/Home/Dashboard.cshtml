@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Panel de Control";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@* ===== ENCABEZADO ===== *@
<div class="dashboard-header">
    <div>
        <h1 class="page-title">Panel de Control</h1>
        <p class="page-subtitle mb-0">Bienvenido, Juan Pérez — Rol: Admin</p>
    </div>
    <span class="dashboard-date">
        <i class="bi bi-calendar3"></i>
        Miércoles, 7 de mayo de 2025
    </span>
</div>

@* ===== FILA KPI CARDS ===== *@
<div class="row g-3 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-blue">
            <div class="kpi-icon" style="background:#dbeafe; color:#2d6cdf;">
                <i class="bi bi-folder2-open"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-number">128</div>
                <div class="kpi-label">Documentos Totales</div>
                <div class="kpi-sub"><i class="bi bi-arrow-up"></i> 12 nuevos este mes</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-yellow">
            <div class="kpi-icon" style="background:#fef9c3; color:#b45309;">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-number">14</div>
                <div class="kpi-label">En Revisión</div>
                <div class="kpi-sub"><i class="bi bi-exclamation-circle"></i> 3 pendientes urgentes</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-green">
            <div class="kpi-icon" style="background:#dcfce7; color:#15803d;">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-number">89</div>
                <div class="kpi-label">Aprobados</div>
                <div class="kpi-sub"><i class="bi bi-calendar-check"></i> Este trimestre</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-red">
            <div class="kpi-icon" style="background:#fee2e2; color:#b91c1c;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-number">25</div>
                <div class="kpi-label">Obsoletos</div>
                <div class="kpi-sub"><i class="bi bi-arrow-clockwise"></i> Requieren actualización</div>
            </div>
        </div>
    </div>

</div>

@* ===== SECCIÓN PESTAÑAS ===== *@
<div class="card mb-4">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="dashboardTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-admin" data-bs-toggle="tab"
                        data-bs-target="#pane-admin" type="button" role="tab">
                    <i class="bi bi-shield-check me-1"></i> Vista Admin
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-revisor" data-bs-toggle="tab"
                        data-bs-target="#pane-revisor" type="button" role="tab">
                    <i class="bi bi-eye me-1"></i> Vista Revisor
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-operario" data-bs-toggle="tab"
                        data-bs-target="#pane-operario" type="button" role="tab">
                    <i class="bi bi-person-workspace me-1"></i> Vista Operario
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body tab-content" id="dashboardTabsContent">

        @* --- Pestaña Admin --- *@
        <div class="tab-pane fade show active" id="pane-admin" role="tabpanel">
            <h6 class="tab-section-title">Actividad Reciente</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-3">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Acción</th>
                            <th>Documento</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="user-chip">MG</span> María García</td>
                            <td>Subió versión</td>
                            <td>Manual de Calidad v3.2</td>
                            <td>06/05/2025</td>
                            <td><span class="badge-estado badge-en-revision">En Revisión</span></td>
                        </tr>
                        <tr>
                            <td><span class="user-chip">CR</span> Carlos Ruiz</td>
                            <td>Aprobó documento</td>
                            <td>Procedimiento ISO-9001</td>
                            <td>05/05/2025</td>
                            <td><span class="badge-estado badge-aprobado">Aprobado</span></td>
                        </tr>
                        <tr>
                            <td><span class="user-chip">AL</span> Ana López</td>
                            <td>Creó borrador</td>
                            <td>Política de Privacidad</td>
                            <td>04/05/2025</td>
                            <td><span class="badge-estado badge-borrador">Borrador</span></td>
                        </tr>
                        <tr>
                            <td><span class="user-chip">JP</span> Juan Pérez</td>
                            <td>Marcó obsoleto</td>
                            <td>Reglamento Interno v1.0</td>
                            <td>03/05/2025</td>
                            <td><span class="badge-estado badge-obsoleto">Obsoleto</span></td>
                        </tr>
                        <tr>
                            <td><span class="user-chip">LT</span> Laura Torres</td>
                            <td>Envió a revisión</td>
                            <td>Plan de Auditoría 2025</td>
                            <td>02/05/2025</td>
                            <td><span class="badge-estado badge-en-revision">En Revisión</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <button type="button" class="btn btn-primary btn-sm">
                <i class="bi bi-clock-history me-1"></i> Ver todo el historial
            </button>
        </div>

        @* --- Pestaña Revisor --- *@
        <div class="tab-pane fade" id="pane-revisor" role="tabpanel">
            <h6 class="tab-section-title">Documentos Pendientes de Revisión</h6>
            <div class="d-flex flex-column gap-3">

                <div class="review-card">
                    <div class="review-card-body">
                        <div class="review-card-info">
                            <div class="review-doc-name">Manual de Calidad v3.2</div>
                            <div class="review-meta">
                                <span><i class="bi bi-person"></i> Subido por María García</span>
                                <span><i class="bi bi-calendar3"></i> 06/05/2025</span>
                            </div>
                        </div>
                        <div class="review-card-actions">
                            <span class="badge-prioridad prioridad-alta">Alta</span>
                            <button type="button" class="btn btn-primary btn-sm">Revisar</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm">Ver detalles</button>
                        </div>
                    </div>
                </div>

                <div class="review-card">
                    <div class="review-card-body">
                        <div class="review-card-info">
                            <div class="review-doc-name">Procedimiento ISO-9001</div>
                            <div class="review-meta">
                                <span><i class="bi bi-person"></i> Subido por Carlos Ruiz</span>
                                <span><i class="bi bi-calendar3"></i> 04/05/2025</span>
                            </div>
                        </div>
                        <div class="review-card-actions">
                            <span class="badge-prioridad prioridad-media">Media</span>
                            <button type="button" class="btn btn-primary btn-sm">Revisar</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm">Ver detalles</button>
                        </div>
                    </div>
                </div>

                <div class="review-card">
                    <div class="review-card-body">
                        <div class="review-card-info">
                            <div class="review-doc-name">Política de Privacidad</div>
                            <div class="review-meta">
                                <span><i class="bi bi-person"></i> Subido por Ana López</span>
                                <span><i class="bi bi-calendar3"></i> 03/05/2025</span>
                            </div>
                        </div>
                        <div class="review-card-actions">
                            <span class="badge-prioridad prioridad-baja">Baja</span>
                            <button type="button" class="btn btn-primary btn-sm">Revisar</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm">Ver detalles</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        @* --- Pestaña Operario --- *@
        <div class="tab-pane fade" id="pane-operario" role="tabpanel">
            <h6 class="tab-section-title">Documentos Vigentes</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Documento</th>
                            <th>Versión</th>
                            <th>Fecha Aprobación</th>
                            <th>Categoría</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Manual de Calidad</td>
                            <td>v3.1</td>
                            <td>01/03/2025</td>
                            <td>Calidad</td>
                            <td><button type="button" class="btn btn-primary btn-sm"><i class="bi bi-download me-1"></i>Descargar</button></td>
                        </tr>
                        <tr>
                            <td>Procedimiento ISO-9001</td>
                            <td>v2.4</td>
                            <td>15/02/2025</td>
                            <td>ISO</td>
                            <td><button type="button" class="btn btn-primary btn-sm"><i class="bi bi-download me-1"></i>Descargar</button></td>
                        </tr>
                        <tr>
                            <td>Reglamento Interno</td>
                            <td>v1.8</td>
                            <td>10/01/2025</td>
                            <td>RRHH</td>
                            <td><button type="button" class="btn btn-primary btn-sm"><i class="bi bi-download me-1"></i>Descargar</button></td>
                        </tr>
                        <tr>
                            <td>Plan de Auditoría</td>
                            <td>v1.2</td>
                            <td>20/04/2025</td>
                            <td>Auditoría</td>
                            <td><button type="button" class="btn btn-primary btn-sm"><i class="bi bi-download me-1"></i>Descargar</button></td>
                        </tr>
                        <tr>
                            <td>Política de Seguridad</td>
                            <td>v2.0</td>
                            <td>05/04/2025</td>
                            <td>Seguridad</td>
                            <td><button type="button" class="btn btn-primary btn-sm"><i class="bi bi-download me-1"></i>Descargar</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@* ===== FILA INFERIOR ===== *@
<div class="row g-3">

    @* Documentos por Estado *@
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-pie-chart me-2"></i> Documentos por Estado
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <div class="progress-label">
                        <span>Aprobados</span>
                        <span class="progress-count">89 / 128</span>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width:70%;" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100">70%</div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="progress-label">
                        <span>En Revisión</span>
                        <span class="progress-count">14 / 128</span>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width:11%;" aria-valuenow="11" aria-valuemin="0" aria-valuemax="100">11%</div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="progress-label">
                        <span>Borrador</span>
                        <span class="progress-count">16 / 128</span>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-secondary" role="progressbar" style="width:13%;" aria-valuenow="13" aria-valuemin="0" aria-valuemax="100">13%</div>
                    </div>
                </div>

                <div class="mb-0">
                    <div class="progress-label">
                        <span>Obsoletos</span>
                        <span class="progress-count">25 / 128</span>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width:20%;" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">20%</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* Acciones Rápidas *@
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-lightning me-2"></i> Acciones Rápidas
            </div>
            <div class="card-body">
                <div class="quick-actions-grid">

                    <button type="button" class="quick-action-btn quick-action-blue">
                        <i class="bi bi-upload"></i>
                        <span>Subir Documento</span>
                    </button>

                    <button type="button" class="quick-action-btn quick-action-green">
                        <i class="bi bi-check2-all"></i>
                        <span>Aprobar Pendientes</span>
                    </button>

                    <button type="button" class="quick-action-btn quick-action-yellow">
                        <i class="bi bi-search"></i>
                        <span>Buscar Documento</span>
                    </button>

                    <button type="button" class="quick-action-btn quick-action-gray">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                        <span>Generar Reporte</span>
                    </button>

                </div>
            </div>
        </div>
    </div>

</div>
