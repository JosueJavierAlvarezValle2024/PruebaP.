@model DashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Panel de Control";
    int total = Model.TotalDocumentos;
    int pctAprobados  = total > 0 ? (int)(Model.Aprobados  * 100.0 / total) : 0;
    int pctRevision   = total > 0 ? (int)(Model.EnRevision * 100.0 / total) : 0;
    int pctBorradores = total > 0 ? (int)(Model.Borradores * 100.0 / total) : 0;
    int pctObsoletos  = total > 0 ? (int)(Model.Obsoletos  * 100.0 / total) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@* ===== ENCABEZADO ===== *@
<div class="dashboard-header">
    <div>
        <h1 class="page-title">Panel de Control</h1>
        <p class="page-subtitle mb-0">Bienvenido, @Model.NombreUsuario — Rol: @Model.RolUsuario</p>
    </div>
    <span class="dashboard-date">
        <i class="bi bi-calendar3"></i>
        @Model.FechaHoy
    </span>
</div>

@* ===== FILA KPI CARDS ===== *@
<div class="row g-3 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-blue">
            <div class="kpi-icon" style="background:#dbeafe; color:#2d6cdf;">
                <i class="bi bi-folder2-open"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-number">@Model.TotalDocumentos</div>
                <div class="kpi-label">Documentos Totales</div>
                <div class="kpi-sub"><i class="bi bi-database"></i> En el sistema</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-yellow">
            <div class="kpi-icon" style="background:#fef9c3; color:#b45309;">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-number">@Model.EnRevision</div>
                <div class="kpi-label">En Revisión</div>
                <div class="kpi-sub"><i class="bi bi-exclamation-circle"></i> Pendientes de revisión</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-green">
            <div class="kpi-icon" style="background:#dcfce7; color:#15803d;">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-number">@Model.Aprobados</div>
                <div class="kpi-label">Aprobados</div>
                <div class="kpi-sub"><i class="bi bi-calendar-check"></i> Vigentes</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-red">
            <div class="kpi-icon" style="background:#fee2e2; color:#b91c1c;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-number">@Model.Obsoletos</div>
                <div class="kpi-label">Obsoletos</div>
                <div class="kpi-sub"><i class="bi bi-arrow-clockwise"></i> Requieren actualización</div>
            </div>
        </div>
    </div>

</div>

@* ===== SECCIÓN PESTAÑAS ===== *@
<div class="card mb-4">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="dashboardTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-admin" data-bs-toggle="tab"
                        data-bs-target="#pane-admin" type="button" role="tab">
                    <i class="bi bi-shield-check me-1"></i> Vista Admin
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-revisor" data-bs-toggle="tab"
                        data-bs-target="#pane-revisor" type="button" role="tab">
                    <i class="bi bi-eye me-1"></i> Vista Revisor
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-operario" data-bs-toggle="tab"
                        data-bs-target="#pane-operario" type="button" role="tab">
                    <i class="bi bi-person-workspace me-1"></i> Vista Operario
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body tab-content" id="dashboardTabsContent">

        @* --- Pestaña Admin: Actividad Reciente --- *@
        <div class="tab-pane fade show active" id="pane-admin" role="tabpanel">
            <h6 class="tab-section-title">Actividad Reciente</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-3">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Acción</th>
                            <th>Documento</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ActividadReciente.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">Sin actividad registrada.</td>
                            </tr>
                        }
                        @foreach (var aud in Model.ActividadReciente)
                        {
                            <tr>
                                <td>
                                    <span class="user-chip">@EstadoHelper.Iniciales(aud.Usuario?.Nombre ?? "?")</span>
                                    @(aud.Usuario?.Nombre ?? "—")
                                </td>
                                <td>@aud.Accion</td>
                                <td>@(aud.Documento?.Titulo ?? "—")</td>
                                <td>@aud.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (aud.Documento != null)
                                    {
                                        <span class="badge-estado @EstadoHelper.ToBadgeClass(aud.Documento.Estado)">
                                            @EstadoHelper.ToLabel(aud.Documento.Estado)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <a asp-action="Index" asp-controller="Documentos" class="btn btn-primary btn-sm">
                <i class="bi bi-folder2-open me-1"></i> Ver todos los documentos
            </a>
        </div>

        @* --- Pestaña Revisor: Pendientes --- *@
        <div class="tab-pane fade" id="pane-revisor" role="tabpanel">
            <h6 class="tab-section-title">Documentos Pendientes de Revisión</h6>
            @if (!Model.PendientesRevision.Any())
            {
                <p class="text-muted py-3 text-center">No hay documentos en revisión.</p>
            }
            <div class="d-flex flex-column gap-3">
                @foreach (var doc in Model.PendientesRevision)
                {
                    <div class="review-card">
                        <div class="review-card-body">
                            <div class="review-card-info">
                                <div class="review-doc-name">@doc.Titulo v@doc.Version</div>
                                <div class="review-meta">
                                    <span><i class="bi bi-person"></i> @(doc.Usuario?.Nombre ?? "—")</span>
                                    <span><i class="bi bi-calendar3"></i> @doc.FechaModificacion.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <div class="review-card-actions">
                                <a asp-action="Approve" asp-controller="Documentos" asp-route-id="@doc.Id"
                                   class="btn btn-primary btn-sm">Revisar</a>
                                <a asp-action="Details" asp-controller="Documentos" asp-route-id="@doc.Id"
                                   class="btn btn-outline-secondary btn-sm">Ver detalles</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* --- Pestaña Operario: Documentos Vigentes --- *@
        <div class="tab-pane fade" id="pane-operario" role="tabpanel">
            <h6 class="tab-section-title">Documentos Vigentes</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Documento</th>
                            <th>Versión</th>
                            <th>Fecha Aprobación</th>
                            <th>Categoría</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.DocumentosVigentes.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">No hay documentos aprobados.</td>
                            </tr>
                        }
                        @foreach (var doc in Model.DocumentosVigentes)
                        {
                            <tr>
                                <td>@doc.Titulo</td>
                                <td>v@doc.Version</td>
                                <td>@doc.FechaModificacion.ToString("dd/MM/yyyy")</td>
                                <td>@(doc.Categoria ?? "—")</td>
                                <td>
                                    @if (doc.RutaArchivo != null)
                                    {
                                        <a asp-action="Download" asp-controller="Documentos" asp-route-id="@doc.Id"
                                           class="btn btn-primary btn-sm">
                                            <i class="bi bi-download me-1"></i>Descargar
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-controller="Documentos" asp-route-id="@doc.Id"
                                           class="btn btn-outline-primary btn-sm">Ver</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@* ===== FILA INFERIOR ===== *@
<div class="row g-3">

    @* Documentos por Estado *@
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-pie-chart me-2"></i> Documentos por Estado
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <div class="progress-label">
                        <span>Aprobados</span>
                        <span class="progress-count">@Model.Aprobados / @total</span>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-success" role="progressbar"
                             style="width:@pctAprobados%;" aria-valuenow="@pctAprobados" aria-valuemin="0" aria-valuemax="100">
                            @pctAprobados%
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="progress-label">
                        <span>En Revisión</span>
                        <span class="progress-count">@Model.EnRevision / @total</span>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-warning" role="progressbar"
                             style="width:@pctRevision%;" aria-valuenow="@pctRevision" aria-valuemin="0" aria-valuemax="100">
                            @pctRevision%
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="progress-label">
                        <span>Borrador</span>
                        <span class="progress-count">@Model.Borradores / @total</span>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-secondary" role="progressbar"
                             style="width:@pctBorradores%;" aria-valuenow="@pctBorradores" aria-valuemin="0" aria-valuemax="100">
                            @pctBorradores%
                        </div>
                    </div>
                </div>

                <div class="mb-0">
                    <div class="progress-label">
                        <span>Obsoletos</span>
                        <span class="progress-count">@Model.Obsoletos / @total</span>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-danger" role="progressbar"
                             style="width:@pctObsoletos%;" aria-valuenow="@pctObsoletos" aria-valuemin="0" aria-valuemax="100">
                            @pctObsoletos%
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* Acciones Rápidas *@
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-lightning me-2"></i> Acciones Rápidas
            </div>
            <div class="card-body">
                <div class="quick-actions-grid">

                    <a asp-action="Create" asp-controller="Documentos" class="quick-action-btn quick-action-blue">
                        <i class="bi bi-upload"></i>
                        <span>Subir Documento</span>
                    </a>

                    <a asp-action="Index" asp-controller="Documentos" class="quick-action-btn quick-action-green">
                        <i class="bi bi-check2-all"></i>
                        <span>Ver Documentos</span>
                    </a>

                    <a asp-action="Index" asp-controller="Documentos" class="quick-action-btn quick-action-yellow">
                        <i class="bi bi-search"></i>
                        <span>Buscar Documento</span>
                    </a>

                    <button type="button" class="quick-action-btn quick-action-gray">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                        <span>Generar Reporte</span>
                    </button>

                </div>
            </div>
        </div>
    </div>

</div>
