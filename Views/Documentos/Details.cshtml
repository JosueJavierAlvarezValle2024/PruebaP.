@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Detalles del Documento";
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos.css" asp-append-version="true" />
}

@* ===== ENCABEZADO ===== *@
<div class="mb-4">
    <a href="/Documentos/Index" class="doc-back-link">
        <i class="bi bi-arrow-left me-1"></i> Volver a la lista
    </a>
    <div class="details-header mt-2">
        <div class="details-title-group">
            <h1 class="page-title mb-1">Manual de Calidad</h1>
            <span class="badge-estado badge-aprobado">Aprobado</span>
        </div>
        <div class="doc-actions">
            <a href="/Documentos/Edit/1" class="btn btn-secondary">
                <i class="bi bi-pencil me-1"></i> Editar
            </a>
            <a href="#" class="btn btn-primary">
                <i class="bi bi-download me-1"></i> Descargar
            </a>
        </div>
    </div>
</div>

@* ===== CONTENIDO ===== *@
<div class="row g-4">

    @* ===== COLUMNA IZQUIERDA (2/3) ===== *@
    <div class="col-12 col-lg-8">

        @* Información del Documento *@
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i> Información del Documento
            </div>
            <div class="card-body p-0">
                <table class="table mb-0 details-table">
                    <tbody>
                        <tr>
                            <th>Título</th>
                            <td>Manual de Calidad</td>
                        </tr>
                        <tr>
                            <th>Versión</th>
                            <td>v3.2</td>
                        </tr>
                        <tr>
                            <th>Estado</th>
                            <td><span class="badge-estado badge-aprobado">Aprobado</span></td>
                        </tr>
                        <tr>
                            <th>Categoría</th>
                            <td>Calidad</td>
                        </tr>
                        <tr>
                            <th>Fecha de creación</th>
                            <td>01/04/2025</td>
                        </tr>
                        <tr>
                            <th>Última modificación</th>
                            <td>15/04/2025</td>
                        </tr>
                        <tr>
                            <th>Autor</th>
                            <td>Juan Pérez</td>
                        </tr>
                        <tr>
                            <th>Tamaño del archivo</th>
                            <td>2.4 MB</td>
                        </tr>
                        <tr>
                            <th>Formato</th>
                            <td><span class="badge bg-danger-subtle text-danger-emphasis">PDF</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* Descripción *@
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-text-left me-2"></i> Descripción
            </div>
            <div class="card-body">
                <p class="mb-0" style="font-size:0.9rem; color:var(--text-secondary); line-height:1.7;">
                    Este manual establece los lineamientos generales del sistema de gestión de calidad
                    de la organización, conforme a los requisitos de la norma ISO 9001:2015. Incluye
                    el alcance del sistema, la política de calidad, los objetivos estratégicos y la
                    descripción de los procesos clave. Es de cumplimiento obligatorio para todo el
                    personal y aplica a todas las áreas funcionales de la empresa.
                </p>
            </div>
        </div>

        @* Historial de Versiones *@
        <div class="card">
            <div class="card-header">
                <i class="bi bi-clock-history me-2"></i> Historial de Versiones
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Versión</th>
                                <th>Fecha</th>
                                <th>Autor</th>
                                <th>Cambios</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="fw-600">v3.2</span> <span class="badge bg-primary-subtle text-primary ms-1" style="font-size:0.65rem;">Actual</span></td>
                                <td>15/04/2025</td>
                                <td>Juan Pérez</td>
                                <td>Actualización sección 5.3 y anexos</td>
                                <td><button type="button" class="btn btn-outline-primary btn-sm">Ver versión</button></td>
                            </tr>
                            <tr>
                                <td>v3.1</td>
                                <td>01/03/2025</td>
                                <td>María García</td>
                                <td>Revisión política de calidad</td>
                                <td><button type="button" class="btn btn-outline-primary btn-sm">Ver versión</button></td>
                            </tr>
                            <tr>
                                <td>v3.0</td>
                                <td>10/01/2025</td>
                                <td>Carlos Ruiz</td>
                                <td>Reestructuración completa del documento</td>
                                <td><button type="button" class="btn btn-outline-primary btn-sm">Ver versión</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    @* ===== COLUMNA DERECHA (1/3) ===== *@
    <div class="col-12 col-lg-4">

        @* Flujo de Aprobación *@
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-diagram-3 me-2"></i> Flujo de Aprobación
            </div>
            <div class="card-body">
                <div class="approval-flow">

                    <div class="approval-step step-done">
                        <div class="step-icon"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="step-info">
                            <div class="step-name">Borrador</div>
                            <div class="step-date">01/04/2025</div>
                        </div>
                    </div>

                    <div class="approval-step step-done">
                        <div class="step-icon"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="step-info">
                            <div class="step-name">En Revisión</div>
                            <div class="step-date">08/04/2025</div>
                        </div>
                    </div>

                    <div class="approval-step step-active">
                        <div class="step-icon"><i class="bi bi-record-circle-fill"></i></div>
                        <div class="step-info">
                            <div class="step-name">Aprobado</div>
                            <div class="step-date">15/04/2025</div>
                        </div>
                    </div>

                    <div class="approval-step step-pending">
                        <div class="step-icon"><i class="bi bi-circle"></i></div>
                        <div class="step-info">
                            <div class="step-name">Obsoleto</div>
                            <div class="step-date">—</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        @* Acciones *@
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-lightning me-2"></i> Acciones
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <button type="button" class="btn btn-success w-100">
                    <i class="bi bi-check2-circle me-1"></i> Aprobar Documento
                </button>
                <button type="button" class="btn btn-warning w-100">
                    <i class="bi bi-send me-1"></i> Enviar a Revisión
                </button>
                <button type="button" class="btn btn-danger w-100">
                    <i class="bi bi-archive me-1"></i> Marcar como Obsoleto
                </button>
            </div>
        </div>

        @* Información de Auditoría *@
        <div class="card">
            <div class="card-header">
                <i class="bi bi-shield-check me-2"></i> Información de Auditoría
            </div>
            <div class="card-body">
                <div class="audit-row">
                    <span class="audit-label">Creado por</span>
                    <span class="audit-value">Juan Pérez</span>
                </div>
                <div class="audit-row">
                    <span class="audit-label">Fecha de creación</span>
                    <span class="audit-value">01/04/2025</span>
                </div>
                <div class="audit-row">
                    <span class="audit-label">Aprobado por</span>
                    <span class="audit-value">María López</span>
                </div>
                <div class="audit-row">
                    <span class="audit-label">Fecha de aprobación</span>
                    <span class="audit-value">15/04/2025</span>
                </div>
            </div>
        </div>

    </div>
</div>
