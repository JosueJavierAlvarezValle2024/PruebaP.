@model Documento
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Detalles del Documento";

    var estados = new[] { "Borrador", "EnRevision", "Aprobado", "Obsoleto" };
    var audCreacion  = Model.Auditorias.FirstOrDefault(a => a.Accion == "Creó");
    var audAprobacion = Model.Auditorias.LastOrDefault(a => a.Accion == "Aprobó");
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos.css" asp-append-version="true" />
}

@* ===== ENCABEZADO ===== *@
<div class="mb-4">
    <a asp-action="Index" asp-controller="Documentos" class="doc-back-link">
        <i class="bi bi-arrow-left me-1"></i> Volver a la lista
    </a>
    <div class="details-header mt-2">
        <div class="details-title-group">
            <h1 class="page-title mb-1">@Model.Titulo</h1>
            <span class="badge-estado @EstadoHelper.ToBadgeClass(Model.Estado)">
                @EstadoHelper.ToLabel(Model.Estado)
            </span>
        </div>
        <div class="doc-actions">
            <a asp-action="Edit" asp-controller="Documentos" asp-route-id="@Model.Id" class="btn btn-secondary">
                <i class="bi bi-pencil me-1"></i> Editar
            </a>
            @if (Model.RutaArchivo != null)
            {
                <a asp-action="Download" asp-controller="Documentos" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-download me-1"></i> Descargar
                </a>
            }
        </div>
    </div>
</div>

@* ===== CONTENIDO ===== *@
<div class="row g-4">

    @* ===== COLUMNA IZQUIERDA (2/3) ===== *@
    <div class="col-12 col-lg-8">

        @* Información del Documento *@
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i> Información del Documento
            </div>
            <div class="card-body p-0">
                <table class="table mb-0 details-table">
                    <tbody>
                        <tr><th>Título</th><td>@Model.Titulo</td></tr>
                        <tr><th>Versión</th><td>v@Model.Version</td></tr>
                        <tr>
                            <th>Estado</th>
                            <td>
                                <span class="badge-estado @EstadoHelper.ToBadgeClass(Model.Estado)">
                                    @EstadoHelper.ToLabel(Model.Estado)
                                </span>
                            </td>
                        </tr>
                        <tr><th>Categoría</th><td>@(Model.Categoria ?? "—")</td></tr>
                        <tr><th>Fecha de creación</th><td>@Model.FechaCreacion.ToString("dd/MM/yyyy")</td></tr>
                        <tr><th>Última modificación</th><td>@Model.FechaModificacion.ToString("dd/MM/yyyy")</td></tr>
                        <tr><th>Autor</th><td>@(Model.Usuario?.Nombre ?? "—")</td></tr>
                        @if (Model.TamanioKb > 0)
                        {
                            <tr><th>Tamaño del archivo</th><td>@Model.TamanioKb KB</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.Extension))
                        {
                            <tr>
                                <th>Formato</th>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger-emphasis">
                                        @Model.Extension.ToUpper()
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Descripción *@
        @if (!string.IsNullOrEmpty(Model.Descripcion))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-text-left me-2"></i> Descripción
                </div>
                <div class="card-body">
                    <p class="mb-0" style="font-size:0.9rem; color:var(--text-secondary); line-height:1.7;">
                        @Model.Descripcion
                    </p>
                </div>
            </div>
        }

        @* Historial de Versiones *@
        <div class="card">
            <div class="card-header">
                <i class="bi bi-clock-history me-2"></i> Historial de Versiones
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Versión</th>
                                <th>Fecha</th>
                                <th>Autor</th>
                                <th>Cambios</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.HistorialVersiones.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">Sin historial de versiones aún.</td>
                                </tr>
                            }
                            @foreach (var h in Model.HistorialVersiones)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-600">v@h.VersionNueva</span>
                                        @if (h == Model.HistorialVersiones.First())
                                        {
                                            <span class="badge bg-primary-subtle text-primary ms-1" style="font-size:0.65rem;">Actual</span>
                                        }
                                    </td>
                                    <td>@h.FechaCambio.ToString("dd/MM/yyyy")</td>
                                    <td>@(h.Usuario?.Nombre ?? "—")</td>
                                    <td>@(h.Notas ?? $"v{h.VersionAnterior} → v{h.VersionNueva}")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    @* ===== COLUMNA DERECHA (1/3) ===== *@
    <div class="col-12 col-lg-4">

        @* Flujo de Aprobación *@
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-diagram-3 me-2"></i> Flujo de Aprobación
            </div>
            <div class="card-body">
                <div class="approval-flow">
                    @{
                        int estadoIdx = Array.IndexOf(estados, Model.Estado);
                    }
                    @foreach (var (est, idx) in estados.Select((e, i) => (e, i)))
                    {
                        string stepClass;
                        string icon;
                        if (idx < estadoIdx)      { stepClass = "step-done";    icon = "bi-check-circle-fill"; }
                        else if (idx == estadoIdx) { stepClass = "step-active";  icon = "bi-record-circle-fill"; }
                        else                       { stepClass = "step-pending"; icon = "bi-circle"; }

                        <div class="approval-step @stepClass">
                            <div class="step-icon"><i class="bi @icon"></i></div>
                            <div class="step-info">
                                <div class="step-name">@EstadoHelper.ToLabel(est)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Acciones rápidas de estado *@
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-lightning me-2"></i> Acciones
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-action="Approve" asp-controller="Documentos" asp-route-id="@Model.Id"
                   class="btn btn-success w-100">
                    <i class="bi bi-check2-circle me-1"></i> Gestionar Aprobación
                </a>
                <a asp-action="Edit" asp-controller="Documentos" asp-route-id="@Model.Id"
                   class="btn btn-warning w-100">
                    <i class="bi bi-pencil me-1"></i> Editar Documento
                </a>
            </div>
        </div>

        @* Información de Auditoría *@
        <div class="card">
            <div class="card-header">
                <i class="bi bi-shield-check me-2"></i> Información de Auditoría
            </div>
            <div class="card-body">
                <div class="audit-row">
                    <span class="audit-label">Creado por</span>
                    <span class="audit-value">@(audCreacion?.Usuario?.Nombre ?? Model.Usuario?.Nombre ?? "—")</span>
                </div>
                <div class="audit-row">
                    <span class="audit-label">Fecha de creación</span>
                    <span class="audit-value">@Model.FechaCreacion.ToString("dd/MM/yyyy")</span>
                </div>
                @if (audAprobacion != null)
                {
                    <div class="audit-row">
                        <span class="audit-label">Aprobado por</span>
                        <span class="audit-value">@(audAprobacion.Usuario?.Nombre ?? "—")</span>
                    </div>
                    <div class="audit-row">
                        <span class="audit-label">Fecha de aprobación</span>
                        <span class="audit-value">@audAprobacion.Fecha.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
