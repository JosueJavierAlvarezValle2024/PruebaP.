@model ApproveViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Flujo de Aprobación";
    var doc = Model.Documento;
    var estados = new[] { "Borrador", "EnRevision", "Aprobado", "Obsoleto" };
    int estadoIdx = Array.IndexOf(estados, doc.Estado);
}

@section Styles {
    <link rel="stylesheet" href="~/css/aprobacion.css" asp-append-version="true" />
}

@* ===== SECCIÓN 1 — ENCABEZADO ===== *@
<div class="mb-4">
    <a asp-action="Details" asp-controller="Documentos" asp-route-id="@doc.Id" class="doc-back-link">
        <i class="bi bi-arrow-left me-1"></i> Volver al documento
    </a>
    <div class="aprobacion-header mt-2">
        <div>
            <h1 class="page-title mb-1">Flujo de Aprobación</h1>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="aprobacion-docname">@doc.Titulo v@doc.Version</span>
                <span class="badge-estado @EstadoHelper.ToBadgeClass(doc.Estado)">
                    @EstadoHelper.ToLabel(doc.Estado)
                </span>
            </div>
        </div>
    </div>
</div>

@* ===== SECCIÓN 2 — BARRA DE PROGRESO DEL FLUJO ===== *@
<div class="card mb-4">
    <div class="card-body">
        <div class="flujo-pasos">
            @foreach (var (est, idx) in estados.Select((e, i) => (e, i)))
            {
                if (idx < estadoIdx)
                {
                    <div class="flujo-paso paso-completado">
                        <div class="paso-circulo"><i class="bi bi-check-lg"></i></div>
                        <div class="paso-label">@EstadoHelper.ToLabel(est)</div>
                    </div>
                }
                else if (idx == estadoIdx)
                {
                    <div class="flujo-paso paso-activo">
                        <div class="paso-circulo">
                            <i class="bi bi-circle-fill" style="font-size:0.55rem;"></i>
                        </div>
                        <div class="paso-label">@EstadoHelper.ToLabel(est)</div>
                    </div>
                }
                else
                {
                    <div class="flujo-paso paso-pendiente">
                        <div class="paso-circulo"><span>@(idx + 1)</span></div>
                        <div class="paso-label">@EstadoHelper.ToLabel(est)</div>
                    </div>
                }
                @if (idx < estados.Length - 1)
                {
                    <div class="flujo-linea @(idx < estadoIdx ? "flujo-linea-completada" : "")"></div>
                }
            }
        </div>
    </div>
</div>

@* ===== SECCIÓN 3 — PANEL DE DECISIÓN ===== *@
<div class="row g-4 mb-4">

    @* Columna izquierda — Información del Documento *@
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-file-earmark-text me-2"></i> Información del Documento
            </div>
            <div class="card-body p-0">
                <table class="table mb-0 aprobacion-info-table">
                    <tbody>
                        <tr><th>Documento</th><td>@doc.Titulo</td></tr>
                        <tr><th>Versión</th><td>v@doc.Version</td></tr>
                        <tr>
                            <th>Autor</th>
                            <td>
                                <span class="user-chip-sm">@EstadoHelper.Iniciales(doc.Usuario?.Nombre ?? "?")</span>
                                @(doc.Usuario?.Nombre ?? "—")
                            </td>
                        </tr>
                        <tr><th>Fecha modificación</th><td>@doc.FechaModificacion.ToString("dd/MM/yyyy")</td></tr>
                        <tr><th>Categoría</th><td>@(doc.Categoria ?? "—")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Columna derecha — Tomar Decisión *@
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-check2-square me-2"></i> Tomar Decisión
            </div>
            <div class="card-body">
                <form method="post" asp-action="Approve" asp-controller="Documentos" asp-route-id="@doc.Id">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="NuevoEstado" class="form-label fw-500">Cambiar estado a</label>
                        <select id="NuevoEstado" name="NuevoEstado" class="form-select">
                            <option value="" disabled selected>Selecciona una acción...</option>
                            <option value="aprobado">Aprobar</option>
                            <option value="borrador">Rechazar (volver a Borrador)</option>
                            <option value="obsoleto">Marcar como Obsoleto</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="Comentarios" class="form-label fw-500">Comentarios del revisor</label>
                        <textarea id="Comentarios" name="Comentarios" class="form-control" rows="4"
                                  placeholder="Escribe tus observaciones, sugerencias o motivo de rechazo..."></textarea>
                    </div>

                    <div class="requisitos-card mb-4">
                        <div class="requisitos-titulo">
                            <i class="bi bi-list-check me-1"></i> Checklist de requisitos
                        </div>
                        <div class="requisito-item">
                            <input type="checkbox" class="form-check-input" id="req1" />
                            <label class="form-check-label" for="req1">El documento cumple con la normativa vigente</label>
                        </div>
                        <div class="requisito-item">
                            <input type="checkbox" class="form-check-input" id="req2" />
                            <label class="form-check-label" for="req2">La versión y nomenclatura son correctas</label>
                        </div>
                        <div class="requisito-item">
                            <input type="checkbox" class="form-check-input" id="req3" />
                            <label class="form-check-label" for="req3">Fue revisado por el área correspondiente</label>
                        </div>
                        <div class="requisito-item">
                            <input type="checkbox" class="form-check-input" id="req4" />
                            <label class="form-check-label" for="req4">Los anexos y referencias están completos</label>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-lg me-1"></i> Confirmar Decisión
                        </button>
                        <a asp-action="Details" asp-controller="Documentos" asp-route-id="@doc.Id"
                           class="btn btn-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>

</div>

@* ===== SECCIÓN 4 — HISTORIAL DE CAMBIOS DE ESTADO ===== *@
<div class="card">
    <div class="card-header">
        <i class="bi bi-clock-history me-2"></i> Historial de Cambios de Estado
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Historial.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">Sin historial aún.</td>
                        </tr>
                    }
                    @foreach (var aud in Model.Historial)
                    {
                        <tr>
                            <td>@aud.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="user-chip-sm">
                                    @EstadoHelper.Iniciales(aud.Usuario?.Nombre ?? "?")
                                </span>
                                @(aud.Usuario?.Nombre ?? "—")
                            </td>
                            <td>@aud.Accion</td>
                            <td>@aud.Detalle</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
