@model IEnumerable<Documento>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Gestión de Documentos";
    int total = (int)(ViewBag.Total ?? 0);
    int i = 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos.css" asp-append-version="true" />
}

@* ===== ENCABEZADO ===== *@
<div class="dashboard-header mb-4">
    <div>
        <h1 class="page-title">Gestión de Documentos</h1>
        <p class="page-subtitle mb-0">@total documentos en el sistema</p>
    </div>
    <a asp-action="Create" asp-controller="Documentos" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Documento
    </a>
</div>

@* ===== BARRA DE HERRAMIENTAS ===== *@
<div class="card mb-4">
    <div class="card-body">
        <div class="doc-toolbar">
            <div class="doc-search">
                <i class="bi bi-search doc-search-icon"></i>
                <input type="text" class="form-control doc-search-input" placeholder="Buscar por título..." />
            </div>
            <select class="form-select doc-filter">
                <option value="">Todos los estados</option>
                <option value="Borrador">Borrador</option>
                <option value="EnRevision">En Revisión</option>
                <option value="Aprobado">Aprobado</option>
                <option value="Obsoleto">Obsoleto</option>
            </select>
            <select class="form-select doc-filter">
                <option value="">Todas las categorías</option>
                <option value="Calidad">Calidad</option>
                <option value="Seguridad">Seguridad</option>
                <option value="RRHH">RRHH</option>
                <option value="Operaciones">Operaciones</option>
            </select>
        </div>
    </div>
</div>

@* ===== TABLA DE DOCUMENTOS ===== *@
<div class="card mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Versión</th>
                        <th>Estado</th>
                        <th>Categoría</th>
                        <th>Fecha</th>
                        <th>Autor</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-folder2-open fs-3 d-block mb-2"></i>
                                No hay documentos. <a asp-action="Create">Crea el primero.</a>
                            </td>
                        </tr>
                    }
                    @foreach (var doc in Model)
                    {
                        var iconClass = doc.Extension switch {
                            "pdf"  => "bi-file-earmark-pdf text-danger",
                            "docx" => "bi-file-earmark-word text-primary",
                            "xlsx" => "bi-file-earmark-excel text-success",
                            _      => "bi-file-earmark text-secondary"
                        };
                        <tr>
                            <td class="text-muted">@(i++.ToString("D3"))</td>
                            <td class="doc-title-cell">
                                <i class="bi @iconClass me-2"></i>@doc.Titulo
                            </td>
                            <td>v@doc.Version</td>
                            <td>
                                <span class="badge-estado @EstadoHelper.ToBadgeClass(doc.Estado)">
                                    @EstadoHelper.ToLabel(doc.Estado)
                                </span>
                            </td>
                            <td>@(doc.Categoria ?? "—")</td>
                            <td>@doc.FechaModificacion.ToString("dd/MM/yyyy")</td>
                            <td>@(doc.Usuario?.Nombre ?? "—")</td>
                            <td>
                                <div class="doc-actions">
                                    <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-primary btn-sm">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@doc.Id" class="btn btn-secondary btn-sm">Editar</a>
                                    <a asp-action="Approve" asp-route-id="@doc.Id" class="btn btn-success btn-sm">Aprobar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
