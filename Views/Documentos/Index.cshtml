@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Gestión de Documentos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos.css" asp-append-version="true" />
}

@* ===== ENCABEZADO ===== *@
<div class="dashboard-header mb-4">
    <div>
        <h1 class="page-title">Gestión de Documentos</h1>
        <p class="page-subtitle mb-0">128 documentos en el sistema</p>
    </div>
    <a href="/Documentos/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Documento
    </a>
</div>

@* ===== BARRA DE HERRAMIENTAS ===== *@
<div class="card mb-4">
    <div class="card-body">
        <div class="doc-toolbar">
            <div class="doc-search">
                <i class="bi bi-search doc-search-icon"></i>
                <input type="text" class="form-control doc-search-input" placeholder="Buscar por título..." />
            </div>
            <select class="form-select doc-filter">
                <option value="">Todos los estados</option>
                <option value="borrador">Borrador</option>
                <option value="revision">En Revisión</option>
                <option value="aprobado">Aprobado</option>
                <option value="obsoleto">Obsoleto</option>
            </select>
            <select class="form-select doc-filter">
                <option value="">Todas las categorías</option>
                <option value="calidad">Calidad</option>
                <option value="seguridad">Seguridad</option>
                <option value="rrhh">RRHH</option>
                <option value="operaciones">Operaciones</option>
            </select>
        </div>
    </div>
</div>

