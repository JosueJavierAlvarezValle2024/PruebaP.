@model DocumentoFormViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nuevo Documento";
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos.css" asp-append-version="true" />
}

@* ===== ENCABEZADO ===== *@
<div class="mb-4">
    <a asp-action="Index" asp-controller="Documentos" class="doc-back-link">
        <i class="bi bi-arrow-left me-1"></i> Volver a la lista
    </a>
    <h1 class="page-title mt-2">Nuevo Documento</h1>
</div>

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

@* ===== FORMULARIO ===== *@
<form method="post" asp-action="Create" asp-controller="Documentos" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-4">

        @* ===== COLUMNA IZQUIERDA ===== *@
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-file-earmark-plus me-2"></i> Información del Documento
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-500">Título del documento <span class="text-danger">*</span></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ingresa el título del documento" />
                        <span asp-validation-for="Titulo" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Version" class="form-label fw-500">Número de versión</label>
                            <input asp-for="Version" class="form-control" placeholder="ej: 1.0" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="Categoria" class="form-label fw-500">Categoría</label>
                            <select asp-for="Categoria" class="form-select">
                                <option value="">Selecciona una categoría</option>
                                <option value="Calidad">Calidad</option>
                                <option value="Seguridad">Seguridad</option>
                                <option value="RRHH">RRHH</option>
                                <option value="Operaciones">Operaciones</option>
                                <option value="Legal">Legal</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-500">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="4"
                                  placeholder="Describe brevemente el contenido y propósito del documento..."></textarea>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Tags" class="form-label fw-500">Tags / Etiquetas</label>
                        <input asp-for="Tags" class="form-control" placeholder="ej: ISO, calidad, norma" />
                        <div class="form-text">Separa las etiquetas con comas.</div>
                    </div>

                </div>
            </div>
        </div>

        @* ===== COLUMNA DERECHA ===== *@
        <div class="col-12 col-lg-4">

            @* Zona de subida de archivo *@
            <div class="card mb-3">
                <div class="card-header">
                    <i class="bi bi-cloud-upload me-2"></i> Archivo
                </div>
                <div class="card-body">
                    <label for="Archivo" class="dropzone">
                        <i class="bi bi-file-earmark-arrow-up dropzone-icon"></i>
                        <p class="dropzone-text">Arrastra tu archivo aquí o haz clic para seleccionar</p>
                        <p class="dropzone-hint">Formatos permitidos: PDF, DOCX, XLSX (máx. 10MB)</p>
                        <input asp-for="Archivo" accept=".pdf,.docx,.xlsx" class="dropzone-input" />
                    </label>
                </div>
            </div>

            @* Card de Configuración *@
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-gear me-2"></i> Configuración
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="EstadoInicial" class="form-label fw-500">Estado inicial</label>
                        <select asp-for="EstadoInicial" class="form-select">
                            <option value="borrador">Borrador</option>
                            <option value="revision">En Revisión</option>
                        </select>
                    </div>

                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" id="notificarRevisores" name="notificarRevisores" />
                        <label class="form-check-label" for="notificarRevisores">Notificar a revisores</label>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="aprobacionInmediata" name="aprobacionInmediata" />
                        <label class="form-check-label" for="aprobacionInmediata">Requiere aprobación inmediata</label>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @* ===== BOTONES ===== *@
    <div class="doc-form-actions mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy me-1"></i> Guardar como Borrador
        </button>
        <a asp-action="Index" asp-controller="Documentos" class="btn btn-secondary">
            <i class="bi bi-x-lg me-1"></i> Cancelar
        </a>
    </div>

</form>
